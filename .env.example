# STRATOS Weather Intelligence Platform Environment Configuration

# Environment mode: development | staging | production
ENVIRONMENT=development

# Backend API Settings
PROJECT_NAME="STRATOS Weather Intelligence"
API_V1_STR=/api/v1
VERSION=2.4.0

# Weather API Provider: "open-meteo" (100% free, no key needed) or "openweathermap"
WEATHER_API_PROVIDER=open-meteo
WEATHER_API_KEY=

# Cache Settings (in seconds)
CACHE_TTL_WEATHER_SECONDS=600       # 10 minutes
CACHE_TTL_GEOCODING_SECONDS=86400   # 24 hours

# Security & Rate Limiting
RATE_LIMIT_PER_MINUTE=60
BACKEND_CORS_ORIGINS=["*"]
